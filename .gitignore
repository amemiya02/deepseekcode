# Build artifacts
/bin/
/dist/
/dsc
# Root-level dependency / bundler caches (only web/node_modules was ignored
# before, so a stray root node_modules/.vite leaked into the review surface).
/node_modules/
/.vite/
# Root-only: an unanchored `benchrunner` also matches paths like
# bench/cmd/benchrunner/main_test.go, which silently drops tests from PRs.
/benchrunner
*.exe
*.test
*.out

# Local agent state (this binary writes here)
.deepseek/

# Editors
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Coverage
coverage.out
coverage.html

# Go workspace files
go.work
go.work.sum

# Claude Code / AI assistant local state
.claude/
.codegraph/
.omc/
AGENTS.md
CLAUDE.md
CONTEXT.md

docs/superpowers/

# Benchmark output
bench/traces/
bench/reports/
bench/cache-demo/results.json
web/dist/
web/node_modules/
web/package-lock.json
webapp/dist/

# Desktop build artifacts (compiled binaries, app bundles, generated JS bindings)
desktop/build/
desktop/frontend/wailsjs/

# Competitive / strategic analysis docs (session-generated; not tracked source)
# List only the three untracked session files explicitly so the five already-tracked
# files in docs/competitive/ remain visible to editors, CI diff viewers, and `git add`.
docs/competitive/
.superpowers/
.playwright-mcp/
/*.png
web/test-results/
web/playwright-report/
# Playwright visual-QA output (regenerated each run; keep only the dir marker).
web/e2e/screenshots/*
!web/e2e/screenshots/.gitkeep